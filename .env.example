# SQ Consulting - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# Supabase Configuration (Recommended)
# Get these values from your Supabase project dashboard
# https://app.supabase.com/project/_/settings/api
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# Optional: Direct Database Connection
# If not using Supabase, you can connect directly to PostgreSQL
# ============================================
# VITE_DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# Admin Configuration
# ============================================
# VITE_ADMIN_EMAIL=admin@sqconsulting.com
# VITE_ADMIN_PASSWORD_HASH=your-hashed-password

# ============================================
# Email Service (for notifications)
# ============================================
# VITE_EMAIL_SERVICE_API_KEY=your-email-api-key
# VITE_EMAIL_FROM=noreply@sqconsulting.com
